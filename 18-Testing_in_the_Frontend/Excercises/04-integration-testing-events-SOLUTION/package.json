{
  "name": "integration-testing-events-solutions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:unit": "vitest --project Unit_Tests",
    "test:integration": "vitest --project Integration_Tests",
    "lint": "oxlint --type-aware src vite.config.ts",
    "build": "tsc -b && vitest run && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:coverage": "vitest run --coverage",
    "lint:global": "oxlint -c ~/.oxlintrc.json --type-aware src vite.config.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.19",
    "@types/node": "^24.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "daisyui": "^5.0.43",
    "jsdom": "^30.0.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.1.11",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
